# =============================================================================
# SDOC Automated Document Verification Engine - Environment Configuration
# =============================================================================
# Copy this file to .env and configure values as needed.
# Note: Never commit .env to version control.

# -----------------------------------------------------------------------------
# 1. AI & LLM Services (Google Gemini)
# -----------------------------------------------------------------------------
# Optional: Set your Gemini API key for hybrid harmonization, Vision AI,
# on-demand discrepancy explanations, and amendment email drafting.
# When omitted or invalid, SDOC runs in 100% Deterministic Engine Mode.
GEMINI_API_KEY=

# Preferred Gemini model (default: gemini-2.5-flash).
# The system automatically resolves and fails over to available candidates:
# gemini-2.5-flash, gemini-flash-latest, gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 2. Enterprise Storage Configuration
# -----------------------------------------------------------------------------
# Storage backend: local | gcs | firestore (default: local)
STORAGE_BACKEND=local

# Google Cloud Storage bucket name (required only when STORAGE_BACKEND=gcs)
GCS_BUCKET_NAME=

# -----------------------------------------------------------------------------
# 3. Security, Upload & Rate Limiting Guardrails
# -----------------------------------------------------------------------------
# Maximum file upload size in megabytes (default: 5 MB)
MAX_UPLOAD_SIZE_MB=5

# Rate limit for live sandbox verifications per minute per session (default: 15)
SANDBOX_RATE_LIMIT_PER_MINUTE=15

# Maximum automated stage retries for transient errors (default: 3)
MAX_RETRIES=3

# -----------------------------------------------------------------------------
# 4. Production Cloud Run & Web Server Configuration
# -----------------------------------------------------------------------------
# Web server listening port (Cloud Run sets this automatically to 8080)
PORT=8080
STREAMLIT_SERVER_HEADLESS=true
